# Razorpay AI Finance Controller Configuration

# Groq API Key for LLM Exception Explainer & Adversarial Auditor
GROQ_API_KEY=gsk_your_groq_api_key_here

# LLM Model Name
LLM_MODEL=llama-3.3-70b-specdec

# Database Connection URL (Defaults to local SQLite)
DATABASE_URL=sqlite:///data/reconciliation.db

# XGBoost Confidence Thresholds
CONFIDENCE_HIGH=0.85
CONFIDENCE_LOW=0.40

# Server Port Configuration
PORT=8000
